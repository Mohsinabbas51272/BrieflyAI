generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

enum SourceType {
  URL
  YOUTUBE
  PDF
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  name            String
  role            Role           @default(USER)
  plan            Plan           @default(FREE)
  dailyUsageCount Int            @default(0)
  lastUsageDate   DateTime       @default(now())
  geminiApiKey    String?
  openaiApiKey    String?
  summaries       Summary[]
  usageLogs       UsageLog[]
  subscription    Subscription?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Summary {
  id                 String     @id @default(uuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  sourceUrl          String?
  sourceType         SourceType
  originalTextLength Int        @default(0)
  wordCount          Int        @default(0)
  readingTimeMinutes Int        @default(1)
  overview           String     @db.Text
  keyPoints          String[]
  keyInsights        String[]
  actionItems        String[]
  rawExcerpt         String?    @db.Text
  aiModel            String     @default("smart-engine")
  summaryLength      String     @default("standard")
  tone               String     @default("executive")
  category           String     @default("General")
  isFavorite         Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([userId])
  @@index([sourceType])
  @@index([createdAt])
}

model UsageLog {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType SourceType
  aiModel    String
  tokensUsed Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([userId])
}

model Subscription {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             Plan     @default(FREE)
  status           String   @default("ACTIVE")
  stripeCustomerId String?
  currentPeriodEnd DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
